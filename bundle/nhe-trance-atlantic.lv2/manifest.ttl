    a pset:Preset ;
    lv2:appliesTo <https://github.com/Kiwooky/NHE-Trance-Atlantic> ;
    rdfs:label "Whale Call" ;
    rdfs:seeAlso <presets.ttl> .

<https://github.com/Kiwooky/NHE-Trance-Atlantic#preset-just-drifting-aimlessly>
    a pset:Preset ;
    lv2:appliesTo <https://github.com/Kiwooky/NHE-Trance-Atlantic> ;
    rdfs:label "Just drifting aimlessly" ;
    rdfs:seeAlso <presets.ttl> .

<https://github.com/Kiwooky/NHE-Trance-Atlantic#preset-converging-streams>
    a pset:Preset ;
    lv2:appliesTo <https://github.com/Kiwooky/NHE-Trance-Atlantic> ;
    rdfs:label "Converging streams" ;
    rdfs:seeAlso <presets.ttl> .

<https://github.com/Kiwooky/NHE-Trance-Atlantic#preset-bouncing-of-the-floor>
